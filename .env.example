# Client-safe values (required by the SPA and exposed in the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional local dev helper for rendering Google's official GIS button
VITE_GOOGLE_CLIENT_ID=
# Optional GIS toggle. Default uses redirect-based Google sign-in flow.
VITE_USE_GIS_BUTTON=false
# Optional local-dev-only QA override for admin access (comma-separated emails).
# Ignored outside local development mode.
VITE_DEV_ADMIN_EMAILS=
# Public display gate only. Leave false until the Micro shipping decision and
# server-side Stripe Price/Shipping Rate configuration are approved.
VITE_MICRO_CHECKOUT_ENABLED=false

# Server-only values (Supabase Edge Functions / backend only)
# WARNING: Never prefix these with VITE_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Server-side Micro checkout gate. The Edge Function treats every value except
# the exact string "true" as disabled. Keep this false/absent until #717 is resolved.
MICRO_CHECKOUT_ENABLED=false
# Legacy bridge for member sugar pricing. Prefer STRIPE_SUGAR_MEMBER_PRICE_ID.
STRIPE_SUGAR_PRICE_ID=
STRIPE_SUGAR_MEMBER_PRICE_ID=
STRIPE_SUGAR_NON_MEMBER_PRICE_ID=
STRIPE_STICKS_PRICE_ID=
STRIPE_STICKS_MEMBER_PRICE_ID=
# Stripe one-time price for the $2,200 Micro Machine
STRIPE_MICRO_PRICE_ID=
# Stripe Shipping Rate applied once to carts containing a Micro Machine
STRIPE_MICRO_SHIPPING_RATE_ID=
# Stripe recurring monthly price for Plus (set to $100/month)
STRIPE_PLUS_PRICE_ID=
# Stripe Customer Portal configuration for Plus billing and renewal
STRIPE_CUSTOMER_PORTAL_CONFIGURATION_ID=
# Optional local/dev-only support for localhost checkout, billing, and invite URLs.
BLOOMJOY_ALLOW_LOCAL_REDIRECT_URLS=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
INTERNAL_NOTIFICATION_FROM_EMAIL=
# Comma-separated additional internal recipients for quote/procurement/order notifications.
# Ethan and Ian are always included by the Edge Function email helper.
INTERNAL_NOTIFICATION_RECIPIENTS=etrifari@bloomjoysweets.com,ian@bloomjoysweets.com
VIMEO_ACCESS_TOKEN=
NAYAX_LYNX_API_TOKEN=

# Sales reporting automation (server-only)
REPORT_SCHEDULER_SECRET=
REPORTING_INGEST_URL=
REPORTING_INGEST_TOKEN=
REPORTING_ROW_HASH_SALT=
SUNZE_LOGIN_URL=
SUNZE_REPORTING_EMAIL=
SUNZE_REPORTING_PASSWORD=
SUNZE_INGEST_MAX_ROWS=20000
SUNZE_EXPECTED_MACHINE_COUNT=
SUNZE_SYNC_STALE_HOURS=30
SUNZE_REPORTING_TIMEZONE=America/Los_Angeles
GOOGLE_REFUNDS_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Nayax Lynx card lookup for refund correlation (server-only)
# Do not prefix with VITE_; never expose this token to the browser.
NAYAX_LYNX_BASE_URL=https://lynx.nayax.com/operational/v1
NAYAX_LYNX_API_TOKEN_TGPACI_USA_DB=
NAYAX_LOOKUP_WINDOW_HOURS=6
REFUND_NAYAX_CANDIDATE_TTL_HOURS=24
REFUND_REPLY_TO_EMAIL=info@bloomjoysweets.com
# Gmail refund inbox transport (server-only, production disabled by default).
GMAIL_SUPPORT_CLIENT_ID=
GMAIL_SUPPORT_CLIENT_SECRET=
GMAIL_SUPPORT_REFRESH_TOKEN=
GMAIL_SUPPORT_MAILBOX=info@bloomjoysweets.com
# Comma-separated aliases verified as Gmail send-as identities for this mailbox.
# Leave blank until each alias is owner-configured and proven with Gmail SENT evidence.
GMAIL_SUPPORT_SEND_AS_ALIASES=
GMAIL_REFUND_LABEL_ID=
GMAIL_REFUND_START_AT=
GMAIL_REFUND_MAX_THREADS_PER_RUN=100
REFUND_GMAIL_SYNC_SECRET=
REFUND_GMAIL_ENABLED=false
REFUND_GMAIL_SYNC_ENABLED=false
# Default-off, owner-only one-thread intake-shadow lane. The shadow label is
# separate from GMAIL_REFUND_LABEL_ID. Owner/run digests use the all-zero
# sentinel whenever the lane is closed; never put raw identities here.
REFUND_GMAIL_INTAKE_ENABLED=false
GMAIL_REFUND_INTAKE_SHADOW_LABEL_ID=
REFUND_GMAIL_INTAKE_SHADOW_OWNER_SENDER_SHA256=
REFUND_GMAIL_INTAKE_SHADOW_RUN_KEY_SHA256=
# Exactly-once first contact remains disabled until the legacy responder is
# inventoried and the owner-approved label/cutover gates are complete.
REFUND_GMAIL_FIRST_CONTACT_MODE=disabled
REFUND_GMAIL_FIRST_CONTACT_CUTOVER_AT=
REFUND_GMAIL_FIRST_CONTACT_PRODUCTION_LABEL_ID=
REFUND_GMAIL_FIRST_CONTACT_ISOLATED_LABEL_ID=
# Comma-separated owner-controlled synthetic senders; never put real customers here.
REFUND_GMAIL_FIRST_CONTACT_ISOLATED_SENDERS=
REFUND_GMAIL_FIRST_CONTACT_ISOLATED_CONFIRMED=false
REFUND_GMAIL_LEGACY_RESPONDER_DISABLED=false
REFUND_GMAIL_FIRST_CONTACT_CUTOVER_APPROVED=false
REFUND_GMAIL_FIRST_CONTACT_REFUND_URL=https://www.bloomjoyusa.com/refunds/request
REFUND_GMAIL_FIRST_CONTACT_SUPPORT_URL=https://www.bloomjoyusa.com/resources#support-boundaries
# Owner-only one-case Gmail proof runner. Put real values only in a private,
# gitignored env file outside the repo. The runner prints none of these values.
REFUND_SYNTHETIC_GMAIL_PROOF_PROJECT_REF=
REFUND_SYNTHETIC_GMAIL_PROOF_CONFIRM_PROJECT_REF=
REFUND_SYNTHETIC_GMAIL_PROOF_CASE_ID=
REFUND_SYNTHETIC_GMAIL_PROOF_CONFIRM_CASE_ID=
REFUND_SYNTHETIC_GMAIL_PROOF_DATABASE_ADAPTER=
REFUND_SYNTHETIC_GMAIL_PROOF_DATABASE_URL=
REFUND_SYNTHETIC_GMAIL_PROOF_MANAGEMENT_TOKEN=
REFUND_SYNTHETIC_GMAIL_PROOF_ANON_KEY=
REFUND_SYNTHETIC_GMAIL_PROOF_USER_ACCESS_TOKEN=
REFUND_SYNTHETIC_GMAIL_PROOF_LIVE_CONFIRMATION=
# Owner-only intake-shadow ceremony runner. These private inputs belong only
# in a gitignored env file. The CLI accepts no label, sender, thread, recipient,
# body, schedule, or delivery target arguments and prints aggregate evidence only.
REFUND_GMAIL_INTAKE_SHADOW_PROJECT_REF=
REFUND_GMAIL_INTAKE_SHADOW_CONFIRM_PROJECT_REF=
REFUND_GMAIL_INTAKE_SHADOW_RETENTION_POLICY_VERSION=refund_gmail_retention_v1
REFUND_GMAIL_INTAKE_SHADOW_LABEL_SHA256=
REFUND_GMAIL_INTAKE_SHADOW_CONFIRM_LABEL_SHA256=
REFUND_GMAIL_INTAKE_SHADOW_INITIAL_LABEL_ID=
REFUND_GMAIL_INTAKE_SHADOW_INITIALIZE_CONFIRMATION=
REFUND_GMAIL_INTAKE_SHADOW_CONFIRM_OWNER_SENDER_SHA256=
REFUND_GMAIL_INTAKE_SHADOW_MANAGEMENT_TOKEN=
REFUND_GMAIL_INTAKE_SHADOW_SYNC_SECRET=
REFUND_GMAIL_INTAKE_SHADOW_ANON_KEY=
REFUND_GMAIL_INTAKE_SHADOW_OWNER_USER_JWT=
REFUND_GMAIL_INTAKE_SHADOW_LIVE_CONFIRMATION=
REFUND_GMAIL_INTAKE_SHADOW_CLEANUP_COMMITMENT=
REFUND_GMAIL_INTAKE_SHADOW_CLEANUP_TASK_HANDLE=
# Local-copy cleanup is independent of Gmail OAuth/provider availability and defaults off
# until the owner-approved retention policy is recorded in the database.
REFUND_GMAIL_RETENTION_ENABLED=false
REFUND_GMAIL_RETENTION_POLICY_VERSION=refund_gmail_retention_v1
# New Gmail copies fail closed unless the approved quarantine/scanner pipeline is enabled
# and its version matches the owner-reviewed database policy.
REFUND_GMAIL_ATTACHMENT_SCANNER_ENABLED=false
REFUND_GMAIL_ATTACHMENT_SCANNER_VERSION=
# Nayax card refund execution is fail-closed by default. Keep these server-only.
# The controlled pilot uses two separately named, account-scoped write
# credentials. Replace ACCOUNT_KEY with the normalized nayax_account_key.
# The exact contract may explicitly confirm a shared token; there is never a
# fallback to NAYAX_LYNX_API_TOKEN_* or another reporting/read credential.
NAYAX_REFUND_REQUEST_WRITE_TOKEN_ACCOUNT_KEY=
NAYAX_REFUND_APPROVE_WRITE_TOKEN_ACCOUNT_KEY=
NAYAX_REFUND_CONTROLLED_PILOT_RUNNER_ASSERTION=
NAYAX_REFUND_EXECUTION_ENABLED=false
NAYAX_REFUND_EXECUTION_DRY_RUN=true
NAYAX_REFUND_EXECUTION_KILL_SWITCH=true
# Legacy controlled-owner-pilot inputs below are not required by the normal
# authenticated Machine Manager refund action.
NAYAX_REFUND_EXECUTION_SPONSOR_GO_NO_GO=
NAYAX_REFUND_EXECUTION_PROVIDER_CONTRACT_CONFIRMED=false
# Legacy controlled-pilot contract fixture.
NAYAX_REFUND_CONTROLLED_PILOT_CONTRACT_JSON=
NAYAX_REFUND_PROVIDER_TIMEOUT_MS=10000
NAYAX_REFUND_MAX_AMOUNT_CENTS=1000
NAYAX_REFUND_DAILY_AMOUNT_CAP_CENTS=5000
NAYAX_REFUND_DAILY_COUNT_CAP=10
# Dedicated URL-safe HMAC secret (43-256 characters); do not reuse another key.
NAYAX_REFUND_IDEMPOTENCY_SECRET=
# Separate URL-safe function identity (43-256 characters). Register only its
# SHA-256 digest in refund_nayax_provider_callers during an approved gate-on.
NAYAX_REFUND_EXECUTOR_ASSERTION=
# Scheduled refund reminders/escalations. May reuse REPORT_SCHEDULER_SECRET.
REFUND_AUTOMATION_SWEEP_SECRET=
REFUND_AUTOMATION_ENABLED=false
# Independent fail-closed switch for deterministic customer email. The database switch must also be enabled by an owner-approved migration/runbook step.
REFUND_AUTOMATIC_CUSTOMER_CONTACT_ENABLED=false
# Claims older than this are never resent blindly. The sweep reconciles a durable Gmail sent milestone or routes the case to manager review.
REFUND_FOLLOW_UP_CLAIM_STALE_MINUTES=30
# Independent, default-off switch for internal Machine Manager aging notices.
REFUND_MANAGER_AGING_NOTICES_ENABLED=false
# Monday-Friday elapsed-day thresholds in REFUND_AUTOMATION_TIMEZONE. Holidays are not inferred.
REFUND_MANAGER_REMINDER_BUSINESS_DAYS=2
REFUND_MANAGER_ESCALATION_BUSINESS_DAYS=5

# WeCom internal alerting (server-only)
# CorpID from My Company -> Company Info
WECOM_CORP_ID=
# AgentId from App Management -> your app details
WECOM_AGENT_ID=
# Secret from App Management -> your app details (do not expose client-side)
WECOM_AGENT_SECRET=
# Optional comma-separated recipient user IDs for alert fanout
# Example: ethan.trifari,ops.manager
WECOM_ALERT_TO_USERIDS=
